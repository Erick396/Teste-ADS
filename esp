-- LocalScript: TestInterface.lua
-- Interface de testes autorizados

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild("TestToolRemote")

-- Configurações
local DEFAULT_SPEED = 16
local MAX_SPEED = 100
local MAX_DISTANCE = 1000

-- Variáveis
local savedPositions = {}
local selectedPosition = nil
local dragging = false
local dragOffset = nil

-- Funções auxiliares
local function setupCharacter()
    local character = player.Character or player.CharacterAdded:Wait()
    return character
end

local function updatePlayerInfo(infoFrame)
    RunService.RenderStepped:Connect(function()
        local character = player.Character
        if character and character:FindFirstChild("Humanoid") and character:FindFirstChild("HumanoidRootPart") then
            local humanoid = character.Humanoid
            local hrp = character.HumanoidRootPart
            infoFrame.PlayerName.Text = "Jogador: " .. player.Name
            infoFrame.Speed.Text = "Velocidade: " .. humanoid.WalkSpeed
            infoFrame.Position.Text = string.format("Posição: X=%.1f Y=%.1f Z=%.1f", hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
        end
    end)
end

local function setWalkSpeed(value)
    if tonumber(value) and value > 0 and value <= MAX_SPEED then
        remote:FireServer("SetSpeed", value)
    end
end

local function resetWalkSpeed()
    remote:FireServer("SetSpeed", DEFAULT_SPEED)
end

local function teleportToPosition(x, y, z)
    if tonumber(x) and tonumber(y) and tonumber(z) then
        remote:FireServer("Teleport", Vector3.new(x, y, z))
    end
end

local function saveCurrentPosition(name)
    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        if #savedPositions < 5 then
            table.insert(savedPositions, {Name = name, Position = character.HumanoidRootPart.Position})
        end
    end
end

local function teleportToSavedPosition(index)
    if savedPositions[index] then
        remote:FireServer("Teleport", savedPositions[index].Position)
    end
end

local function deleteSavedPosition(index)
    if savedPositions[index] then
        table.remove(savedPositions, index)
    end
end

-- Criação da interface
local function createInterface()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "TestInterface"
    screenGui.Parent = player:WaitForChild("PlayerGui")

    local mainFrame = Instance.new("Frame")
